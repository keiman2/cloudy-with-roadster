@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; background: rgb(238, 241, 233); color: rgb(23, 60, 64); font-family: system-ui, -apple-system, "Noto Sans JP", sans-serif; }

button { font: inherit; cursor: pointer; touch-action: manipulation; }

main { max-width: 1120px; margin: auto; padding: 25px 28px 20px; }

header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 23px; }

.brand { font-weight: 850; letter-spacing: 0.12em; font-size: 13px; }

.brand span { display: inline-block; background: rgb(28, 81, 78); color: rgb(232, 244, 171); padding: 8px 10px; border-radius: 50%; margin-right: 9px; }

.sound { border: 1px solid rgb(194, 206, 195); border-radius: 30px; background: transparent; color: inherit; padding: 9px 15px; font-size: 12px; }

.intro { display: flex; justify-content: space-between; align-items: end; margin-bottom: 20px; }

.eyebrow { font-size: 11px; letter-spacing: 0.2em; font-weight: 700; color: rgb(99, 126, 115); }

h1 { font-size: clamp(27px, 5vw, 48px); letter-spacing: -0.05em; line-height: 1.2; margin: 8px 0px; }

.lead { margin: 0px; font-size: 13px; color: rgb(102, 128, 120); }

.best { font-size: 11px; text-align: right; white-space: nowrap; }

.best strong { display: block; font-size: 24px; color: rgb(35, 84, 81); }

.stage { position: relative; border-radius: 22px; overflow: hidden; background: rgb(125, 186, 198); box-shadow: rgba(27, 74, 56, 0.125) 0px 15px 35px; isolation: isolate; }

canvas { display: block; width: 100%; height: 390px; }

.hud { position: absolute; top: 19px; left: 22px; right: 22px; display: flex; justify-content: space-between; gap: 12px; pointer-events: none; }

.score { color: white; text-shadow: rgba(32, 78, 86, 0.44) 0px 2px 6px; }

.score small { display: block; font-size: 10px; letter-spacing: 0.1em; }

.score b { font-size: 35px; font-variant-numeric: tabular-nums; }

.score span { font-size: 12px; }

.weather { background: rgba(245, 250, 240, 0.91); border: 1px solid rgba(255, 255, 255, 0.44); border-radius: 13px; padding: 10px 14px; min-width: 154px; }

.weather small { font-size: 10px; color: rgb(99, 123, 112); }

.weather b { display: block; font-size: 15px; margin-top: 3px; }

.weather .track { height: 4px; background: rgb(211, 223, 212); border-radius: 4px; margin-top: 8px; }

.weather i { display: block; background: rgb(97, 146, 119); height: 4px; border-radius: 4px; width: 0px; }

.toast { position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); background: rgba(21, 61, 57, 0.91); color: white; border-radius: 30px; padding: 10px 19px; font-size: 12px; white-space: nowrap; pointer-events: none; }

.overlay { position: absolute; inset: 0px; display: flex; justify-content: center; align-items: center; background: rgba(18, 56, 60, 0.25); backdrop-filter: blur(3px); padding: 18px; }

.card { background: rgb(248, 250, 239); border: 1px solid white; box-shadow: rgba(8, 43, 53, 0.25) 0px 15px 60px; border-radius: 21px; padding: 27px; text-align: center; width: 360px; max-width: 100%; }

.card .tag { font-size: 10px; letter-spacing: 0.2em; color: rgb(107, 131, 118); }

.card h2 { font-size: 27px; margin: 12px 0px; }

.card p { font-size: 12px; line-height: 1.9; color: rgb(97, 118, 109); }

.primary { border: 0px; border-radius: 12px; background: rgb(218, 239, 133); color: rgb(37, 70, 52); padding: 14px 25px; font-weight: 800; width: 100%; }

.secondary { border: 1px solid rgb(189, 203, 189); border-radius: 12px; background: transparent; padding: 11px; margin-top: 9px; width: 100%; color: rgb(49, 92, 78); }

.hidden { display: none !important; }

.dashboard { margin-top: 16px; display: grid; grid-template-columns: 1fr 1fr 1.2fr; gap: 12px; }

.meter, .control { border: 1px solid rgb(206, 215, 203); border-radius: 15px; background: rgb(247, 248, 240); padding: 14px 17px; }

.label { font-size: 10px; letter-spacing: 0.08em; color: rgb(118, 137, 124); }

.reading { font-size: 24px; font-weight: 800; margin-top: 5px; line-height: 1.2; }

.reading small { font-size: 11px; font-weight: 500; }

.bar { height: 5px; background: rgb(220, 227, 213); border-radius: 8px; margin-top: 12px; overflow: hidden; }

.bar i { display: block; height: 100%; width: 0px; background: rgb(226, 153, 98); transition: width 0.15s; }

.control { display: flex; flex-direction: column; justify-content: center; gap: 8px; background: rgb(25, 75, 70); border-color: rgb(25, 75, 70); color: rgb(255, 255, 255); }

.control button { border: 0px; border-radius: 9px; background: rgb(218, 239, 133); padding: 13px 8px; color: rgb(41, 73, 54); font-weight: 800; font-size: 14px; }

.control button:disabled { opacity: 0.55; cursor: default; }

.control small { text-align: center; font-size: 10px; color: rgb(190, 208, 190); }

.help { display: flex; gap: 24px; margin-top: 23px; justify-content: space-between; color: rgb(110, 129, 117); font-size: 11px; }

.help b { color: rgb(50, 88, 72); }

.footer { text-align: center; font-size: 10px; letter-spacing: 0.08em; color: rgb(138, 156, 142); margin-top: 23px; }

.keys { font-size: 10px; color: rgb(132, 146, 135); margin-top: 8px; text-align: center; }

button:focus-visible { outline: rgb(231, 168, 94) solid 3px; outline-offset: 3px; }

@media (max-width: 600px) {
  main { padding: 16px 15px; }
  header { margin-bottom: 20px; }
  .intro { margin-bottom: 17px; }
  .lead { font-size: 11px; max-width: 230px; }
  .best strong { font-size: 20px; }
  canvas { height: 340px; }
  .hud { top: 15px; left: 15px; right: 15px; }
  .score b { font-size: 28px; }
  .weather { min-width: 136px; padding: 8px 10px; }
  .dashboard { grid-template-columns: 1fr 1fr; gap: 9px; }
  .control { grid-column: 1 / -1; flex-direction: row; align-items: center; padding: 11px 13px; gap: 12px; }
  .control button { flex: 1 1 0%; }
  .control small { max-width: 105px; line-height: 1.7; }
  .help { gap: 12px; font-size: 10px; line-height: 1.7; margin-top: 16px; }
  .help > div { flex: 1 1 0%; }
  .meter { padding: 11px 14px; }
  .reading { font-size: 22px; }
  .footer { margin-top: 17px; }
  .keys { display: none; }
  .card { padding: 23px; }
  .toast { font-size: 10px; max-width: 95%; padding: 10px 14px; }
}
